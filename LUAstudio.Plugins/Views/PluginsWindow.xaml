<Window x:Class="LUAstudio.Plugins.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:LUAstudio.Plugins.Views"
        mc:Ignorable="d"
        Title="Plugins — LuaStudio"
        Height="640"
        Width="900"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgRoot}"
        ResizeMode="CanResize">


    
    <Window.Resources>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="44" Height="22">
                            <Border x:Name="Outer"
                                    Background="{StaticResource BrushBgPanel}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="11"/>
                            <Border x:Name="Inner"
                                    Width="18" Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="2,0,0,0"
                                    Background="{StaticResource BrushTextMuted}"
                                    CornerRadius="9"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Inner" Property="Background" Value="White"/>
                                <Setter TargetName="Inner" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Inner" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

     
        <DataTemplate x:Key="MarketplaceCardTemplate">
            <Border Margin="4"
                    Padding="10"
                    Background="{StaticResource BrushBgPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Width="200" Height="150"
                    Cursor="Hand"
                    ToolTip="{Binding ShortDescription}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Text="{Binding ShortDescription}"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="40"
                               Margin="0,6,0,0"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="⭐" Foreground="{StaticResource BrushWarning}"/>
                        <TextBlock Text="{Binding Rating}" Foreground="{StaticResource BrushTextMuted}" FontSize="12" Margin="4,0,8,0"/>
                        <TextBlock Text="{Binding Downloads, StringFormat={}{0} downloads}" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

   
        <DataTemplate x:Key="InstalledPluginRowTemplate">
            <Grid Margin="0,2">
                <Border Padding="8,6"
                        Background="Transparent"
                        CornerRadius="4"
                        BorderBrush="Transparent"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="{Binding HealthColor}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushText}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Version}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11"
                                   Margin="8,0"/>
                        <CheckBox Grid.Column="3"
                                  IsChecked="{Binding IsEnabled}"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  Margin="8,0"/>
                        <Button Grid.Column="4"
                                Content="⋯"
                                Style="{StaticResource ToolbarIconButton}"
                                Width="24" Height="24"
                                Foreground="{StaticResource BrushTextMuted}"/>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PluginDetailTemplate">
            <ScrollViewer>
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="48" Height="48"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                            <TextBlock Text="{Binding Author}" Foreground="{StaticResource BrushTextMuted}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding FullDescription}"
                               Foreground="{StaticResource BrushText}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <Expander Header="Version History" Margin="0,8,0,0" Foreground="{StaticResource BrushText}">
                        <ItemsControl ItemsSource="{Binding Changelog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource BrushTextMuted}" Margin="12,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Header="Permissions" Margin="0,8,0,0" Foreground="{StaticResource BrushText}">
                        <ItemsControl ItemsSource="{Binding Permissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4" Margin="2" Background="{StaticResource BrushBgHover}" CornerRadius="4">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource BrushText}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Header="Dependencies" Margin="0,8,0,0" Foreground="{StaticResource BrushText}">
                        <TreeView ItemsSource="{Binding DependencyTree}" Background="Transparent" BorderThickness="0">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Dependencies}">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushText}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="Compatible with:" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Compatibility}" Foreground="{StaticResource BrushText}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Install" Style="{StaticResource SettingsAccentButton}" Width="80"/>
                        <Button Content="Remove" Style="{StaticResource SettingsButton}" Width="80" Margin="8,0,0,0"/>
                        <Button Content="Open Config" Style="{StaticResource SettingsButton}" Width="100" Margin="8,0,0,0"/>
                        <Button Content="View Source" Style="{StaticResource SettingsButton}" Width="100" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushBgToolbar}"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SettingsTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <ToggleButton Grid.Column="1"
                              Content="🛠 Dev Mode"
                              IsChecked="{Binding IsDevMode}"
                              Style="{StaticResource SettingsToggleButton}"
                              Margin="0,0,8,0"/>
                <Button Grid.Column="2"
                        Content="⚙"
                        Style="{StaticResource ToolbarIconButton}"
                        ToolTip="Plugin System Settings"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Grid.RowSpan="2"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0">
            <TabItem Header="🧩 Installed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{StaticResource BrushBgPanel}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="8,6" Orientation="Horizontal">
                                <Button Content="Disable All" Style="{StaticResource SettingsButton}" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="Update All" Style="{StaticResource SettingsButton}" FontSize="11" Margin="0,0,4,0"/>
                                <Button Content="Uninstall" Style="{StaticResource SettingsButton}" FontSize="11"/>
                            </StackPanel>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding InstalledPlugins}"
                                     SelectedItem="{Binding SelectedInstalledPlugin}"
                                     ItemTemplate="{StaticResource InstalledPluginRowTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BrushBorder}" HorizontalAlignment="Center"/>

                    <ContentControl Grid.Column="2"
                                    Content="{Binding SelectedInstalledPlugin}"
                                    ContentTemplate="{StaticResource PluginDetailTemplate}"/>
                </Grid>
            </TabItem>

            <TabItem Header="🌍 Discover">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource BrushBgToolbar}"
                            Padding="8,6">
                        <WrapPanel>
                            <TextBlock Text="Language:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0"/>
                            <ComboBox SelectedItem="{Binding SelectedLanguage}" Style="{StaticResource SettingsComboBox}" Width="100" Margin="0,0,12,0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="C#"/>
                                <ComboBoxItem Content="Lua"/>
                                <ComboBoxItem Content="JS"/>
                            </ComboBox>

                            <TextBlock Text="Category:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0"/>
                            <ComboBox SelectedItem="{Binding SelectedCategory}" Style="{StaticResource SettingsComboBox}" Width="100" Margin="0,0,12,0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="AI"/>
                                <ComboBoxItem Content="UI"/>
                                <ComboBoxItem Content="Debug"/>
                                <ComboBoxItem Content="Tools"/>
                            </ComboBox>

                            <TextBlock Text="Sort:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0"/>
                            <ComboBox SelectedItem="{Binding SelectedSort}" Style="{StaticResource SettingsComboBox}" Width="110">
                                <ComboBoxItem Content="Trending"/>
                                <ComboBoxItem Content="New"/>
                                <ComboBoxItem Content="Rating"/>
                                <ComboBoxItem Content="Downloads"/>
                            </ComboBox>

                            <ToggleButton Content="⭐ Favorites"
                                          IsChecked="{Binding ShowFavoritesOnly}"
                                          Style="{StaticResource SettingsToggleButton}"
                                          Margin="12,0,0,0"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding MarketplacePlugins}"
                                          ItemTemplate="{StaticResource MarketplaceCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>

                        <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BrushBorder}" HorizontalAlignment="Center"/>

                        <ContentControl Grid.Column="2"
                                        Content="{Binding SelectedMarketplacePlugin}"
                                        ContentTemplate="{StaticResource PluginDetailTemplate}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="🔄 Updates">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding AvailableUpdates}"
                             SelectedItem="{Binding SelectedUpdate}"
                             Background="{StaticResource BrushBgPanel}"
                             BorderBrush="{StaticResource BrushBorder}"
                             BorderThickness="0,0,1,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,4">
                                    <TextBlock Text="{Binding PluginName}" Foreground="{StaticResource BrushText}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentVersion}" Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock Text=" → " Foreground="{StaticResource BrushWarning}"/>
                                        <TextBlock Text="{Binding NewVersion}" Foreground="{StaticResource BrushAccent}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BrushBorder}" HorizontalAlignment="Center"/>

                    <ScrollViewer Grid.Column="2" Margin="16">
                        <StackPanel>
                            <TextBlock Text="Changelog" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>
                            <TextBlock Text="{Binding SelectedUpdate.ChangelogDiff}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <Button Content="Update" Style="{StaticResource SettingsAccentButton}" Width="80" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="⚙️ Settings">
                <ScrollViewer>
                    <StackPanel Margin="16">
                        <TextBlock Text="Plugin System Settings" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrushText}"/>

                        <Expander Header="General" IsExpanded="True" Margin="0,8,0,0" Foreground="{StaticResource BrushText}">
                            <StackPanel Margin="16,6">
                                <CheckBox Content="Enable plugins globally" IsChecked="{Binding GlobalEnabled}" Style="{StaticResource SettingsCheckBox}"/>
                                <CheckBox Content="Auto‑update all plugins" IsChecked="{Binding AutoUpdateAll}" Style="{StaticResource SettingsCheckBox}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Update check interval:" VerticalAlignment="Center" Foreground="{StaticResource BrushTextMuted}" Width="140"/>
                                    <ComboBox SelectedItem="{Binding UpdateInterval}" Style="{StaticResource SettingsComboBox}" Width="120">
                                        <ComboBoxItem Content="Daily"/>
                                        <ComboBoxItem Content="Weekly"/>
                                        <ComboBoxItem Content="Monthly"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Sandbox / Permissions" Margin="0,8,0,0" Foreground="{StaticResource BrushText}">
                            <StackPanel Margin="16,6">
                                <CheckBox Content="Warn on file system access" IsChecked="{Binding WarnFileAccess}" Style="{StaticResource SettingsCheckBox}"/>
                                <CheckBox Content="Block network access by default" IsChecked="{Binding BlockNetwork}" Style="{StaticResource SettingsCheckBox}" Margin="0,4,0,0"/>
                                <CheckBox Content="Allow runtime hooks" IsChecked="{Binding AllowHooks}" Style="{StaticResource SettingsCheckBox}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Dependencies and Conflicts" Margin="0,8,0,0" Foreground="{StaticResource BrushText}">
                            <StackPanel Margin="16,6">
                                <CheckBox Content="Auto‑install missing dependencies" IsChecked="{Binding AutoInstallDeps}" Style="{StaticResource SettingsCheckBox}"/>
                                <CheckBox Content="Show conflict warnings" IsChecked="{Binding ShowConflicts}" Style="{StaticResource SettingsCheckBox}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="Developer Mode" Margin="0,8,0,0" Foreground="{StaticResource BrushText}">
                            <StackPanel Margin="16,6">
                                <CheckBox Content="Enable debug logging" IsChecked="{Binding DebugLogging}" Style="{StaticResource SettingsCheckBox}"/>
                                <CheckBox Content="Show internal APIs in explorer" IsChecked="{Binding ShowInternalApis}" Style="{StaticResource SettingsCheckBox}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>