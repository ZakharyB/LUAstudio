<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LUAstudio.Execution.Abstractions\LUAstudio.Execution.Abstractions.csproj" />
    <ProjectReference Include="..\LUAstudio.Languages\LUAstudio.Languages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoStudio.AvalonEdit" Version="1.0.2026.606" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Luau" Version="0.1.6" />
    <PackageReference Include="Luau.Native" Version="0.1.6" />
  </ItemGroup>

  <Target Name="CopyNativeLuauToOutputRoot" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\libluau.dll"
          DestinationFiles="$(OutputPath)libluau.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutputPath)runtimes\win-x64\native\libluau.dll')" />
  </Target>

</Project>
