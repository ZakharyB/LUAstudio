<UserControl x:Class="LUAstudio.Settings.Controls.ColorSettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="32" d:DesignWidth="400">
    <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0"
                   Style="{StaticResource SettingsLabel}"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBox Grid.Column="1"
                 Style="{StaticResource SettingsTextBox}"
                 Text="{Binding HexValue, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
        <Border Grid.Column="2"
                Width="28"
                Height="28"
                Margin="8,0,0,0"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="4">

            <Button Background="Transparent"
                    BorderThickness="0"
                    Click="OnColorClicked">
                <Border CornerRadius="4"
                        Background="{Binding PreviewBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Button>
        </Border>
    </Grid>
</UserControl>
