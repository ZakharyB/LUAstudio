<Window x:Class="LUAstudio.Settings.Views.ColorWheelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Picker"
        Width="320"
        SizeToContent="Height"
        MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D31"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3A3D42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2D5BFF"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <Trigger Property="Tag" Value="Invalid">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B30"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Canvas Width="240"
                Height="240"
                HorizontalAlignment="Center">

            <Ellipse x:Name="Wheel"
                     Width="240"
                     Height="240"
                     MouseDown="Wheel_MouseDown"
                     MouseMove="Wheel_MouseMove"
                     MouseUp="Wheel_MouseUp"/>

            <Ellipse x:Name="Selector"
                     Width="12"
                     Height="12"
                     Stroke="White"
                     StrokeThickness="2"
                     Fill="Transparent"
                     IsHitTestVisible="False"/>
        </Canvas>

        <Border Grid.Row="1"
                Width="220"
                Height="40"
                HorizontalAlignment="Center"
                Margin="0,12,0,0"
                CornerRadius="6"
                BorderBrush="#444"
                BorderThickness="1"
                Background="{Binding PreviewBrush}"/>

        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center">

            <TextBox Width="140"
                     Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding HexError}" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">

                <Button Content="Cancel"
                        Width="80"
                        Style="{StaticResource ActionButton}"
                        Click="Cancel_Click"/>

                <Button Content="Apply"
                        Width="80"
                        Margin="8,0,0,0"
                        Background="#2D5BFF"
                        BorderBrush="#2D5BFF"
                        Foreground="White"
                        Style="{StaticResource ActionButton}"
                        Click="Ok_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>
</Window>