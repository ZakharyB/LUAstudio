<Window x:Class="LUAstudio.Settings.Views.ColorWheelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Picker"
        Width="320"
        Height="380"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2D31"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3A3D42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3F46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#4A525C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="260"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">

            <Ellipse x:Name="Wheel"
                     Width="240"
                     Height="240"
                     MouseDown="Wheel_MouseDown"
                     MouseMove="Wheel_MouseMove"
                     MouseUp="Wheel_MouseUp"
                     MouseLeave="Wheel_MouseLeave"/>

        </Grid>

        <Border Grid.Row="1"
                Height="40"
                Margin="0,12,0,0"
                CornerRadius="6"
                BorderBrush="#444"
                BorderThickness="1"
                Background="{Binding PreviewBrush}"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">

            <TextBox Width="120"
                     Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,10,0"
                     Height="28"
                     VerticalContentAlignment="Center"/>

            <Button Content="Cancel"
                    Width="80"
                    Style="{StaticResource ActionButton}"
                    Click="Cancel_Click"/>

            <Button Content="Apply"
                    Width="80"
                    Margin="8,0,0,0"
                    Background="#2D5BFF"
                    BorderBrush="#2D5BFF"
                    Foreground="White"
                    Style="{StaticResource ActionButton}"
                    Click="Ok_Click"/>
        </StackPanel>

    </Grid>
</Window>