<Window x:Class="LUAstudio.Settings.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LUAstudio.Settings.Views"
        Title="Settings — LuaStudio"
        Height="640"
        Width="900"
        MinHeight="480"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushBgRoot}"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushBgToolbar}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{StaticResource BrushTextMuted}"
                           Text="Changes save automatically and apply immediately." />
            </StackPanel>
        </Border>

        <views:SettingsView Grid.Row="1" />

        <Border Grid.Row="2"
                Background="{StaticResource BrushBgToolbar}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                        Style="{StaticResource SettingsAccentButton}"
                        MinWidth="100"
                        IsDefault="True"
                        Click="CloseButton_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
 