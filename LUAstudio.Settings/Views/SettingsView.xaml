<UserControl x:Class="LUAstudio.Settings.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:LUAstudio.Settings.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BrushBgRoot}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,1,0"
                Padding="8">
            <StackPanel>
                <TextBlock Text="Settings"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           Margin="8,8,8,12" />
                <ListBox x:Name="CategoryList"
                         Style="{StaticResource SettingsNavList}"
                         SelectedIndex="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SettingsNavItem}" />
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Editor" />
                    <ListBoxItem Content="Syntax colors" />
                    <ListBoxItem Content="IntelliSense" />
                    <ListBoxItem Content="Diagnostics" />
                    <ListBoxItem Content="Workspace" />
                </ListBox>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,20">
            <StackPanel MaxWidth="640">

                <StackPanel x:Name="EditorPage">
                    <TextBlock Text="Editor" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />
                    <TextBlock Text="Font, layout, and display options for the code editor."
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Font family" />
                        <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding EditorFontFamily, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SettingsLabel}"
                                   Text="Font size (pt)" />

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding EditorFontSize, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <CheckBox  Style="{StaticResource SettingsCheckBox}" Content="Bold font" IsChecked="{Binding EditorFontBold}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Italic font" IsChecked="{Binding EditorFontItalic}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Show line numbers" IsChecked="{Binding EditorShowLineNumbers}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Word wrap" IsChecked="{Binding EditorWordWrap}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Convert tabs to spaces" IsChecked="{Binding EditorConvertTabsToSpaces}" />

                    <TextBlock Text="Breakpoints &amp; Navigation"
                               Style="{StaticResource SettingsSectionHeader}"
                               Margin="0,16,0,8" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Breakpoint margin width (px)" />
                        <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding EditorBreakpointMarginWidth, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Line highlight duration (sec)" />
                        <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding EditorHighlightDurationSeconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Show relative line numbers" IsChecked="{Binding EditorShowRelativeLineNumbers}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Highlight current line" IsChecked="{Binding EditorHighlightCurrentLine}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Show bracket highlighting" IsChecked="{Binding EditorShowBracketHighlighting}" />
                    
                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SettingsLabel}"
                                   Text="Tab width" />

                        <TextBox Grid.Column="1"
                                 Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding EditorTabWidth, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    
                    <TextBlock Text="Editor chrome" Style="{StaticResource SettingsSectionHeader}" />
                    <controls:ColorSettingRow Label="Text color" HexValue="{Binding EditorForeground, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Background" HexValue="{Binding EditorBackground, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel x:Name="ColorsPage" Visibility="Collapsed">
                    <TextBlock Text="Syntax colors" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />
                    <TextBlock Text="Customize Lua syntax highlighting. Changes apply immediately."
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <controls:ColorSettingRow Label="Default text" HexValue="{Binding EditorColorText, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Keywords" HexValue="{Binding EditorColorKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Strings" HexValue="{Binding EditorColorString, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Numbers" HexValue="{Binding EditorColorNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Comments" HexValue="{Binding EditorColorComment, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Operators" HexValue="{Binding EditorColorOperator, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Functions" HexValue="{Binding EditorColorFunction, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Types" HexValue="{Binding EditorColorType, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Built-ins" HexValue="{Binding EditorColorBuiltin, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Globals" HexValue="{Binding EditorColorGlobal, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Brackets" HexValue="{Binding EditorColorBracket, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="TODO markers" HexValue="{Binding EditorColorTodo, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Local methods" HexValue="{Binding EditorColorLocalMethod, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Local properties" HexValue="{Binding EditorColorLocalProperty, UpdateSourceTrigger=PropertyChanged}" />
                    <controls:ColorSettingRow Label="Ghost text" HexValue="{Binding EditorColorGhostText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel x:Name="IntelliSensePage" Visibility="Collapsed">
                    <TextBlock Text="IntelliSense" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />
                    <TextBlock Text="Control completion, suggestions, and smart editing behavior."
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Enable autocomplete (Ctrl+Space and triggers)" IsChecked="{Binding EditorAutoComplete}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Inline ghost completions" IsChecked="{Binding EditorInlineCompletions}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Auto-pair brackets and quotes" IsChecked="{Binding EditorAutoPairBrackets}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Smart Enter (auto-indent blocks)" IsChecked="{Binding EditorSmartEnter}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Semantic highlighting" IsChecked="{Binding EditorSemanticHighlighting}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Auto-switch to file when opened from explorer" IsChecked="{Binding EditorAutoSwitchOnOpen}" />
                </StackPanel>

                <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed">
                    <TextBlock Text="Diagnostics &amp; Linting" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />
                    <TextBlock Text="Semantic analysis, lint rules, and environment profiles."
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Enable diagnostics and lint squiggles" IsChecked="{Binding DiagnosticsEnabled}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Strict type checking mode" IsChecked="{Binding DiagnosticsStrictMode}" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Show require dependency graph panel" IsChecked="{Binding DiagnosticsShowRequireGraph}" />

                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="Environment profile" />
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding EnvironmentProfileOptions}"
                                  SelectedItem="{Binding DiagnosticsEnvironmentProfile, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="WorkspacePage" Visibility="Collapsed">
                    <TextBlock Text="Workspace" Style="{StaticResource SettingsSectionHeader}" Margin="0,0,0,8" />
                    <CheckBox Style="{StaticResource SettingsCheckBox}" Content="Restore workspace folders on startup" IsChecked="{Binding RestoreWorkspaceOnStartup}" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SettingsLabel}"
                                   Text="{DynamicResource Language}" />

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource SettingsComboBox}"
                                  ItemsSource="{Binding LanguageOptions}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="DisplayName" />
                    </Grid>
                    
                    <TextBlock Text="Application" Style="{StaticResource SettingsSectionHeader}" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingsLabel}" Text="FPS limit" />
                        <TextBox Grid.Column="1" Style="{StaticResource SettingsTextBox}"
                                 Text="{Binding FpsLimit, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
