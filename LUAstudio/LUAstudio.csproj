<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\LUAstudio.Abstractions\LUAstudio.Abstractions.csproj" />
      <ProjectReference Include="..\LUAstudio.Core\LUAstudio.Core.csproj" />
      <ProjectReference Include="..\LUAstudio.Editor\LUAstudio.Editor.csproj" />
      <ProjectReference Include="..\LUAstudio.IDE\LUAstudio.IDE.csproj" />
      <ProjectReference Include="..\LUAstudio.Git\LUAstudio.Git.csproj" />
      <ProjectReference Include="..\LUAstudio.Plugins\LUAstudio.Plugins.csproj" />
      <ProjectReference Include="..\LUAstudio.Settings\LUAstudio.Settings.csproj" />
      <ProjectReference Include="..\LUAstudio.Storage\LUAstudio.Storage.csproj" />
      <ProjectReference Include="..\LUAstudio.Workspace\LUAstudio.Workspace.csproj" />
      <ProjectReference Include="..\LUAstudio.Execution\LUAstudio.Execution.csproj" />
      <ProjectReference Include="..\LUAstudio.ExecutionHost\LUAstudio.ExecutionHost.csproj" />
      <ProjectReference Include="..\LUAstudio.Themes\LUAstudio.Themes.csproj" />
      <ProjectReference Include="..\LUAstudio.Tools\LUAstudio.Tools.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
      <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.74.1" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
      <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\Assets\Icons\*.svg" Link="Assets\Icons\%(Filename)%(Extension)">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\Assets\Roblox\api-dump.json" Link="Assets\Roblox\api-dump.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="Assets\Editor\Lua.xshd" Link="Assets\Editor\Lua.xshd">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Assets\Fonts\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="EditorHelpers.cs">
        <DependentUpon>DocumentEditorView.xaml</DependentUpon>
      </Compile>
      <Compile Update="InputDialog.cs">
        <DependentUpon>DocumentEditorView.xaml</DependentUpon>
      </Compile>
      <Compile Update="ErrorSquiggleRenderer.cs">
        <DependentUpon>DocumentEditorView.xaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    </PropertyGroup>

    <Target Name="KillLingeringExecutionHost" BeforeTargets="PrepareForBuild">
      <Exec Command="taskkill /F /IM LUAstudio.ExecutionHost.exe 2&gt;nul || ver > nul"
            IgnoreExitCode="true" />
    </Target>
    <Target Name="CopyExecutionHost" AfterTargets="Build">
        <MSBuild Projects="..\LUAstudio.ExecutionHost\LUAstudio.ExecutionHost.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)" />
        <ItemGroup>
            <ExecutionHostFiles Include="..\LUAstudio.ExecutionHost\bin\$(Configuration)\net8.0\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(ExecutionHostFiles)"
              DestinationFolder="$(OutputPath)%(RecursiveDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyNativeLuauToOutputRoot" AfterTargets="Build">
        <Copy SourceFiles="$(OutputPath)runtimes\win-x64\native\libluau.dll"
              DestinationFiles="$(OutputPath)libluau.dll"
              SkipUnchangedFiles="true"
              Condition="Exists('$(OutputPath)runtimes\win-x64\native\libluau.dll')" />
    </Target>

</Project>
