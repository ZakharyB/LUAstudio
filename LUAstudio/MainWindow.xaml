<Window x:Class="LUAstudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:local="clr-namespace:LUAstudio"
        xmlns:documents="clr-namespace:LUAstudio.IDE.Documents;assembly=LUAstudio.IDE"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Height="720"
        Width="1200">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveActiveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsActiveCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open…" Command="{Binding OpenDocumentCommand}" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveActiveCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As…" Command="{Binding SaveAsActiveCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Close" Command="{Binding CloseActiveCommand}" InputGestureText="Ctrl+W" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="Git: —" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="Sync: —" />
            </StatusBarItem>
        </StatusBar>
        <dock:DockingManager x:Name="DockManager">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Vertical">
                    <dock:LayoutPanel Orientation="Horizontal">
                        <dock:LayoutAnchorablePane dock:DockWidth="240">
                            <dock:LayoutAnchorable Title="Explorer"
                                                   CanClose="False"
                                                   ContentId="Explorer">
                                <TreeView>
                                    <TreeViewItem Header="Workspace (placeholder)" IsExpanded="True" />
                                </TreeView>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                        <dock:LayoutDocumentPane>
                            <dock:LayoutDocument Title="Editor" CanClose="False">
                                <TabControl ItemsSource="{Binding OpenDocuments}"
                                            SelectedItem="{Binding ActiveDocument, Mode=TwoWay}">
                                    <TabControl.ItemContainerStyle>
                                        <Style TargetType="TabItem">
                                            <Setter Property="HeaderTemplate">
                                                <Setter.Value>
                                                    <DataTemplate DataType="{x:Type documents:TextDocument}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" />
                                                            <TextBlock Margin="4,0,0,0"
                                                                       Text="*"
                                                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TabControl.ItemContainerStyle>
                                    <TabControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type documents:TextDocument}">
                                            <local:DocumentEditorView Document="{Binding}" />
                                        </DataTemplate>
                                    </TabControl.ContentTemplate>
                                </TabControl>
                            </dock:LayoutDocument>
                        </dock:LayoutDocumentPane>
                    </dock:LayoutPanel>
                    <dock:LayoutAnchorablePane dock:DockHeight="180">
                        <dock:LayoutAnchorable Title="Output" ContentId="Output" CanClose="False">
                            <TextBlock Padding="8"
                                       Text="Output (placeholder)"
                                       VerticalAlignment="Center" />
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>
                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>
    </DockPanel>
</Window>
