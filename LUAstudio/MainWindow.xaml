<Window x:Class="LUAstudio.MainWindow"
        x:Name="RootShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="https://github.com/Dirkster99/AvalonDock"
        xmlns:local="clr-namespace:LUAstudio"
        xmlns:conv="clr-namespace:LUAstudio.Converters"
        xmlns:documents="clr-namespace:LUAstudio.IDE.Documents;assembly=LUAstudio.IDE"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Height="800"
        Width="1280"
        MinHeight="520"
        MinWidth="960"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BrushBgRoot}"
        StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewDocumentCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDocumentCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveActiveCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsActiveCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource BrushBgRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgToolbar}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                PreviewMouseLeftButtonDown="TitleBar_OnPreviewMouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,8,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                IsHitTestVisible="False">
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Text="Lua" />
                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushText}" Text="Studio" />
                    </StackPanel>

                    <Menu VerticalAlignment="Center"
                          Background="Transparent"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N" />
                            <MenuItem Header="_Open file…" Command="{Binding OpenDocumentCommand}" InputGestureText="Ctrl+O" />
                            <MenuItem Header="Open _folder…" Command="{Binding Explorer.AddWorkspaceRootCommand}" />
                            <Separator />
                            <MenuItem Header="_Save" Command="{Binding SaveActiveCommand}" InputGestureText="Ctrl+S" />
                            <MenuItem Header="Save _as…" Command="{Binding SaveAsActiveCommand}" InputGestureText="Ctrl+Shift+S" />
                            <Separator />
                            <MenuItem Header="_Close" Command="{Binding CloseActiveCommand}" InputGestureText="Ctrl+W" />
                        </MenuItem>
                        <MenuItem Header="_View">
                            <MenuItem Header="Reset tool window layout" Click="ResetDockLayout_OnClick" />
                        </MenuItem>
                    </Menu>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="8,0,12,0"
                            IsHitTestVisible="False">
                    <TextBlock Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               Text="{Binding ActiveDocument.DisplayName, Mode=OneWay, TargetNullValue=''}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="4,0,0,0"
                               Foreground="{StaticResource BrushWarning}"
                               FontSize="12"
                               Text="*"
                               Visibility="{Binding ActiveDocument.IsDirty, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_OnClick"
                            ToolTip="Minimize"
                            Content="&#xE921;" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_OnClick"
                            ToolTip="Maximize"
                            Content="&#xE922;" />
                    <Button Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_OnClick"
                            ToolTip="Close"
                            Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <dock:DockingManager x:Name="DockManager"
                            Grid.Row="1"
                            Background="{StaticResource BrushBgRoot}">
            <dock:LayoutRoot>
                <dock:LayoutPanel Orientation="Horizontal">
                    <dock:LayoutAnchorablePane DockWidth="280">
                        <dock:LayoutAnchorable Title="Explorer"
                                               ContentId="Explorer"
                                               CanClose="False"
                                               CanHide="True"
                                               CanAutoHide="True">
                            <local:WorkspaceExplorerView DataContext="{Binding Explorer}" />
                        </dock:LayoutAnchorable>
                    </dock:LayoutAnchorablePane>
                    <dock:LayoutPanel Orientation="Vertical">
                        <dock:LayoutDocumentPane>
                            <dock:LayoutDocument Title="Editor"
                                                 ContentId="Editor"
                                                 CanClose="False">
                                <Grid Background="{StaticResource BrushBgEditor}">
                                    <TabControl ItemsSource="{Binding OpenDocuments}"
                                                SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                                                Visibility="{Binding HasOpenDocuments, Converter={StaticResource BoolToVisibility}}">
                                        <TabControl.ItemContainerStyle>
                                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                                <Setter Property="HeaderTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate DataType="{x:Type documents:TextDocument}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Foreground="{StaticResource BrushText}"
                                                                           Text="{Binding DisplayName, Mode=OneWay}" />
                                                                <TextBlock Margin="4,0,0,0"
                                                                           Foreground="{StaticResource BrushWarning}"
                                                                           Text="●"
                                                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TabControl.ItemContainerStyle>
                                        <TabControl.ContentTemplate>
                                            <DataTemplate DataType="{x:Type documents:TextDocument}">
                                                <local:DocumentEditorView Document="{Binding}" />
                                            </DataTemplate>
                                        </TabControl.ContentTemplate>
                                    </TabControl>

                                    <Border Visibility="{Binding HasOpenDocuments, Converter={StaticResource InverseBoolToVisibility}}"
                                            Background="{StaticResource BrushBgEditor}">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    MaxWidth="400">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushText}"
                                                       Text="No file open" />
                                            <TextBlock Margin="0,8,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       Text="Open a file from the File menu or Explorer."
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </dock:LayoutDocument>
                        </dock:LayoutDocumentPane>
                        <dock:LayoutAnchorablePane DockHeight="150">
                            <dock:LayoutAnchorable Title="Output"
                                                   ContentId="Output"
                                                   CanClose="False"
                                                   CanHide="True"
                                                   CanAutoHide="True">
                                <Border Background="{StaticResource BrushBgPanel}"
                                        Padding="10">
                                    <TextBlock Foreground="{StaticResource BrushTextMuted}"
                                               Text="Build and diagnostics will appear here."
                                               VerticalAlignment="Top" />
                                </Border>
                            </dock:LayoutAnchorable>
                        </dock:LayoutAnchorablePane>
                    </dock:LayoutPanel>
                </dock:LayoutPanel>
            </dock:LayoutRoot>
        </dock:DockingManager>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Foreground="{StaticResource BrushText}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Ln {0}, Col {1}">
                            <Binding Path="CaretLine" Mode="OneWay" />
                            <Binding Path="CaretColumn" Mode="OneWay" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Foreground="{StaticResource BrushTextMuted}"
                           Text="{Binding ActiveDocumentPath, Mode=OneWay, TargetNullValue=''}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="480" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <CheckBox Content="Restore workspace on startup"
                          IsChecked="{Binding RestoreWorkspaceOnStartup, Mode=TwoWay}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ExternalDiskMessage, TargetNullValue=''}"
                           Foreground="{StaticResource BrushWarning}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="360" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
