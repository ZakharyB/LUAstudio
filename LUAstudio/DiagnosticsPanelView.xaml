<UserControl x:Class="LUAstudio.DiagnosticsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgPanel}">

    <UserControl.Resources>

        <Style x:Key="ToolWindowItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3574F0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2650B5"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolWindowListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#10FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#20FFFFFF"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Border Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8">

                <TextBlock DockPanel.Dock="Top"
                           Text="{DynamicResource UiProblems}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           Margin="0,0,0,6"/>

                <ListView x:Name="ProblemsList"
                          ItemsSource="{Binding Problems}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{StaticResource BrushText}"
                          ItemContainerStyle="{StaticResource ToolWindowItemStyle}">

                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BrushBgPanel}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GridViewColumnHeader">
                                        <Border x:Name="HeaderBorder"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="6"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                Margin="2,0,2,4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#1A3574F0"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="#263574F0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.Resources>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource UiCode}" DisplayMemberBinding="{Binding Code}" Width="80"/>
                            <GridViewColumn Header="{DynamicResource UiSeverity}" DisplayMemberBinding="{Binding Severity}" Width="80"/>
                            <GridViewColumn Header="{DynamicResource UiMessage}" DisplayMemberBinding="{Binding Message}" Width="420"/>
                        </GridView>
                    </ListView.View>

                </ListView>
            </DockPanel>

            <Separator Grid.Row="1"
                       Background="{StaticResource BrushBorder}"
                       Margin="0,4"/>

            <DockPanel Grid.Row="2" Margin="8">

                <TextBlock DockPanel.Dock="Top"
                           Text="{DynamicResource UiRequireGraph}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           Margin="0,6,0,6"/>

                <ListBox ItemsSource="{Binding RequireGraphLines}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource BrushTextMuted}"
                         FontFamily="Consolas"
                         ItemContainerStyle="{StaticResource ToolWindowListBoxItemStyle}"/>

            </DockPanel>

        </Grid>
    </Border>
</UserControl>