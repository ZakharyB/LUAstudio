<Window x:Class="LUAstudio.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LuaStudio"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        MinWidth="360"
        Background="{StaticResource BrushBgPanel}">
    <Border Padding="16" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushText}" />
            <TextBox x:Name="InputBox"
                     Margin="0,0,0,12"
                     Padding="8,6"
                     Background="{StaticResource BrushBgEditor}"
                     Foreground="{StaticResource BrushText}"
                     BorderBrush="{StaticResource BrushBorder}"
                     CaretBrush="{StaticResource BrushText}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="80" Margin="0,0,8,0" Padding="12,6" IsDefault="True" Click="Ok_Click">OK</Button>
                <Button MinWidth="80" Padding="12,6" IsCancel="True">Cancel</Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
