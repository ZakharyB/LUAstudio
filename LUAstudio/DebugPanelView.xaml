<UserControl x:Class="LUAstudio.DebugPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushBgPanel}">

    <UserControl.Resources>
        <Style x:Key="ToolWindowItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3574F0"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2650B5"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DebugButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3574F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BrushBgPanel}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Debug Toolbar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushBgToolbar}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource DebugButtonStyle}"
                            Command="{Binding RunOrContinueCommand}"
                            IsEnabled="{Binding CanRun}"
                            ToolTip="{DynamicResource UiRunContinueF5}">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DebugButtonStyle}"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding CanStop}"
                            ToolTip="{DynamicResource UiStopShiftF5}"
                            Margin="4,0,0,0">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DebugButtonStyle}"
                            Command="{Binding PauseCommand}"
                            IsEnabled="{Binding CanPause}"
                            ToolTip="{DynamicResource UiPauseF6}"
                            Margin="4,0,0,0">
                        <TextBlock Text="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Separator Width="1" Background="{StaticResource BrushBorder}" Margin="8,0"/>
                    <Button Style="{StaticResource DebugButtonStyle}"
                            Command="{Binding StepOverCommand}"
                            IsEnabled="{Binding CanStepOver}"
                            ToolTip="{DynamicResource UiStepOverF10}"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DebugButtonStyle}"
                            Command="{Binding StepIntoCommand}"
                            IsEnabled="{Binding CanStepInto}"
                            ToolTip="{DynamicResource UiStepIntoF11}"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE76D;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource DebugButtonStyle}"
                            Command="{Binding StepOutCommand}"
                            IsEnabled="{Binding CanStepOut}"
                            ToolTip="{DynamicResource UiStepOutShiftF11}"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Separator Width="1" Background="{StaticResource BrushBorder}" Margin="8,0"/>
                    <Button Style="{StaticResource DebugButtonStyle}"
                            Command="{Binding ContinueCommand}"
                            IsEnabled="{Binding CanContinue}"
                            ToolTip="{DynamicResource UiContinueF5}"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Separator Width="1" Background="{StaticResource BrushBorder}" Margin="8,0"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               Margin="8,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="State: {0}">
                                <Binding Path="SessionState" Mode="OneWay"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Debug Panes -->
            <TabControl Grid.Row="1" Background="Transparent">
                <!-- Variables Tab -->
                <TabItem Header="{DynamicResource UiVariables}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="8,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding WatchExpression, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource BrushBgEditor}" Foreground="{StaticResource BrushText}"
                                     BorderBrush="{StaticResource BrushBorder}" Padding="7,4"
                                     ToolTip="{DynamicResource UiEvaluateAnExpressionInTheSelectedStackFrame}"/>
                            <Button Grid.Column="1" Content="{DynamicResource UiEvaluate}" Command="{Binding EvaluateWatchCommand}"
                                    Style="{StaticResource DebugButtonStyle}" Margin="6,0"/>
                            <Button Grid.Column="2" Content="{DynamicResource UiRefresh}" Command="{Binding RefreshVariablesCommand}"
                                    Style="{StaticResource DebugButtonStyle}"/>
                        </Grid>
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding Variables}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemContainerStyle="{StaticResource ToolWindowItemStyle}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource UiName}" DisplayMemberBinding="{Binding Name}" Width="120"/>
                                    <GridViewColumn Header="{DynamicResource UiValue}" DisplayMemberBinding="{Binding Value}" Width="200"/>
                                    <GridViewColumn Header="{DynamicResource UiType}" DisplayMemberBinding="{Binding TypeName}" Width="100"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Stack Trace Tab -->
                <TabItem Header="{DynamicResource UiCallStack}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                                Content="{DynamicResource UiRefresh}"
                                Command="{Binding RefreshStackCommand}"
                                Style="{StaticResource DebugButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="8,6"
                                Padding="12,4"/>
                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding StackFrames}"
                                  SelectedItem="{Binding SelectedStackFrame}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ItemContainerStyle="{StaticResource ToolWindowItemStyle}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource UiFunction}" DisplayMemberBinding="{Binding Name}" Width="200"/>
                                    <GridViewColumn Header="{DynamicResource UiFile}" DisplayMemberBinding="{Binding SourcePath}" Width="250"/>
                                    <GridViewColumn Header="{DynamicResource UiLine}" DisplayMemberBinding="{Binding Line}" Width="60"/>
                                    <GridViewColumn Header="{DynamicResource UiColumn}" DisplayMemberBinding="{Binding Column}" Width="60"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <!-- Breakpoints Tab -->
                <TabItem Header="{DynamicResource UiBreakpoints}">
                    <ListView ItemsSource="{Binding Breakpoints}"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource ToolWindowItemStyle}"
                              Margin="8">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource UiFile}" DisplayMemberBinding="{Binding SourcePath}" Width="300"/>
                                <GridViewColumn Header="{DynamicResource UiLine}" DisplayMemberBinding="{Binding Line}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <!-- Output Tab -->
                <TabItem Header="{DynamicResource UiOutput}">
                    <Grid Background="{StaticResource BrushBgEditor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="8,6">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource UiClear}" Command="{Binding ClearOutputCommand}"
                                    Style="{StaticResource DebugButtonStyle}"/>
                            <TextBlock Text="{DynamicResource UiDEBUGCONSOLE}" Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding OutputLog}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource BrushText}" FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12" Padding="8,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
